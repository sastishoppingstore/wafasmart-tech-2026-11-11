.hero-glow{position:absolute;top:50%;left:50%;width:min(98%,540px);aspect-ratio:1;transform:translate(-50%,-52%);border-radius:50%;pointer-events:none;
  background:radial-gradient(circle at 50% 50%,rgba(255,200,61,.18),rgba(139,61,255,.11) 38%,rgba(37,211,102,.055) 56%,transparent 70%);filter:blur(14px);animation:glowFloat 8s ease-in-out infinite}
.stage{perspective:1100px;height:410px;display:flex;justify-content:center;align-items:center;position:relative;z-index:2;width:100%;touch-action:pan-y}
.stage::before{content:"";position:absolute;left:50%;bottom:8px;width:min(72%,320px);height:44px;transform:translateX(-50%);border-radius:50%;background:radial-gradient(ellipse,rgba(255,200,61,.2),rgba(139,61,255,.08) 45%,transparent 72%);filter:blur(10px);pointer-events:none;z-index:0}
.stage::after{content:"";position:absolute;left:50%;bottom:26px;width:min(62%,270px);height:30px;transform:translateX(-50%);border-radius:50%;background:rgba(0,0,0,.52);filter:blur(14px);pointer-events:none;z-index:1}
.cube{--w:min(74vw,290px);position:relative;width:var(--w);height:350px;transform-style:preserve-3d;transform:translateZ(calc(var(--w)/-2)) rotateX(-14deg) rotateY(0deg);transition:none;will-change:transform;z-index:3}
@keyframes cubeSpin{from{transform:translateZ(calc(var(--w)/-2)) rotateX(-14deg) rotateY(0deg)}to{transform:translateZ(calc(var(--w)/-2)) rotateX(-14deg) rotateY(-360deg)}}
.cube.is-spinning{animation:cubeSpin 8s linear infinite}
.cube.is-offscreen,.stage:hover .cube.is-spinning,.stage:focus-within .cube.is-spinning{animation-play-state:paused}
.face{position:absolute;inset:0;border-radius:24px;padding:13px;backface-visibility:hidden;background:linear-gradient(160deg,var(--f1),var(--f2));transform-style:preserve-3d;display:flex;flex-direction:column;justify-content:flex-start;color:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.16),inset 0 -70px 80px rgba(0,0,0,.14);transition:box-shadow .45s ease}
.face:nth-child(1){--f1:#2563eb;--f2:#0b1d63;transform:rotateY(0deg) translateZ(calc(var(--w)/2))}
.face:nth-child(2){--f1:#8b3dff;--f2:#2a0e6b;transform:rotateY(90deg) translateZ(calc(var(--w)/2))}
.face:nth-child(3){--f1:#00b3a4;--f2:#064b52;transform:rotateY(180deg) translateZ(calc(var(--w)/2))}
.face:nth-child(4){--f1:#ff4d5e;--f2:#6b0f26;transform:rotateY(270deg) translateZ(calc(var(--w)/2))}
.cube-top,.cube-bottom{position:absolute;left:0;top:50%;width:var(--w);height:var(--w);margin-top:calc(var(--w)/-2);border-radius:24px;backface-visibility:hidden;background:
  radial-gradient(120% 100% at 20% 0%,rgba(255,255,255,.16),transparent 45%),
  linear-gradient(135deg,#1c2b58,#0a1126 62%,#131d3d);
  border:1px solid rgba(255,255,255,.18);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.06),inset 0 0 55px rgba(139,61,255,.12);
  display:grid;place-items:center;color:rgba(255,255,255,.42);font-family:var(--sora);font-size:.68rem;font-weight:800;letter-spacing:.24em;text-transform:uppercase}
.cube-top::before,.cube-bottom::before{content:"";position:absolute;inset:16px;border:1px solid rgba(255,255,255,.08);border-radius:16px}
.cube-top{transform:rotateX(90deg) translateZ(175px)}
.cube-bottom{transform:rotateX(-90deg) translateZ(175px);background:radial-gradient(120% 100% at 80% 100%,rgba(255,200,61,.12),transparent 48%),linear-gradient(135deg,#111a34,#070c1a 65%,#0d1429)}
.face::before{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:
  radial-gradient(120% 70% at 0% 0%,rgba(255,255,255,.22),transparent 46%),
  linear-gradient(180deg,rgba(255,255,255,.1),transparent 28%),
  radial-gradient(75% 45% at 100% 100%,rgba(0,0,0,.26),transparent 70%)}
.face::after{content:"";position:absolute;inset:12px;border-radius:17px;border:1px solid rgba(255,255,255,.1);pointer-events:none}
.face>*{position:relative;z-index:2;transition:opacity .26s ease}
.face:not(.is-active) .f-body{opacity:.62}
.face:not(.is-active) .f-media{opacity:.72}
.f-media{position:relative;height:140px;flex:none;border-radius:15px;overflow:hidden;transform:translateZ(14px);border:1px solid rgba(255,255,255,.22);background:rgba(0,0,0,.25);box-shadow:0 12px 24px rgba(0,0,0,.25)}
.f-media img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform .6s var(--ease)}
.face.is-active .f-media img{transform:scale(1.08)}
.f-media::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 38%,rgba(0,0,0,.5));pointer-events:none}
.f-media.red img{opacity:.9}
.f-media .f-media-ic{position:absolute;left:9px;bottom:9px;z-index:2;width:36px;height:36px;border-radius:11px;display:grid;place-items:center;background:rgba(8,13,28,.72);border:1px solid rgba(255,255,255,.3);backdrop-filter:blur(6px);box-shadow:0 8px 18px rgba(0,0,0,.3),inset 0 1px 0 rgba(255,255,255,.28);transform:translateZ(10px)}
.f-media .f-media-ic .ic{width:19px;height:19px}
.f-body{display:flex;flex-direction:column;flex:1;min-height:0;padding-top:8px;transition:opacity .26s ease}
.face.is-active{box-shadow:inset 0 0 0 1px rgba(255,255,255,.24),inset 0 0 46px rgba(255,255,255,.05)}
.f-icon{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;flex:none;margin-bottom:12px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.3);box-shadow:0 10px 20px rgba(0,0,0,.2),inset 0 1px 0 rgba(255,255,255,.3);transform:translateZ(16px)}
.f-icon .ic{width:23px;height:23px}
.f-price{align-self:flex-start;display:inline-flex;align-items:center;gap:5px;margin-bottom:9px;padding:5px 9px;border-radius:8px;background:rgba(0,0,0,.24);border:1px solid rgba(255,255,255,.25);color:#fff;
  font-size:.66rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;line-height:1;transform:translateZ(16px);backdrop-filter:blur(4px)}
.f-price::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--gold);box-shadow:0 0 8px rgba(255,200,61,.65)}
.f-title{font-family:var(--sora);font-size:clamp(1.2rem,4.9vw,1.42rem);line-height:1.12;letter-spacing:-.03em;margin:0 0 6px;transform:translateZ(18px);overflow-wrap:break-word}
.f-desc{font-size:.76rem;line-height:1.5;color:rgba(255,255,255,.82);margin:0 0 15px;transform:translateZ(12px);max-width:23ch}
.f-actions{display:flex;align-items:center;gap:8px;margin-top:auto;transform:translateZ(18px)}
.f-actions .btn{flex:1 1 0;min-width:0;height:38px;padding:0 10px;font-size:13px;border-radius:10px;gap:4px}
.f-order{color:#251700;background:linear-gradient(180deg,#fff3be,#ffc83d 54%,#f0a800);box-shadow:0 3px 0 #7a4d00,0 8px 14px rgba(0,0,0,.26),inset 0 1px 0 #fffbe2}
.f-order:hover{transform:translateY(-1px);box-shadow:0 4px 0 #7a4d00,0 10px 18px rgba(0,0,0,.3),inset 0 1px 0 #fffef0}
.f-order:active{transform:translateY(2px);box-shadow:0 1px 0 #7a4d00,inset 0 1px 0 #fff3b4}
.f-quote{color:#fff;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);box-shadow:0 3px 0 rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.25)}
.f-quote:hover{transform:translateY(-1px);background:rgba(255,255,255,.22);box-shadow:0 4px 0 rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.3)}
.f-quote:active{transform:translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.2)}
.cube-dots{display:flex;align-items:center;justify-content:center;gap:7px;margin-top:2px;position:relative;z-index:3}
.cube-dot{position:relative;display:grid;place-items:center;width:28px;height:28px;padding:0;border:0;background:none;cursor:pointer}
.cube-dot i{display:block;width:8px;height:8px;border-radius:999px;background:rgba(255,255,255,.26);transition:width .35s var(--ease),background .35s,box-shadow .35s}
.cube-dot:hover i{background:rgba(255,255,255,.5)}
.cube-dot[aria-pressed="true"] i{width:26px;background:linear-gradient(90deg,#ffe08a,#ffc83d);box-shadow:0 0 12px rgba(255,200,61,.45)}
.cube-hint{margin:2px 0 0;color:#6d7b98;font-size:.65rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;text-align:center;position:relative;z-index:3}

</style>
