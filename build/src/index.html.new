if(seen){pl.parentNode.removeChild(pl);document.documentElement.style.setProperty('--hero-delay','0s');return;}
if(!pl.classList.contains('pl-photo'))return;window.WAFA SMART TECH_GATE=1;var done=0,shown=0;function finish(){if(done)return;done=1;if(!shown){shown=1;pl.classList.add('is-in');}pl.classList.add('is-done');try{sessionStorage.setItem('sfiva.seen','1');}catch(e){}setTimeout(function(){if(pl.parentNode)pl.parentNode.removeChild(pl);},1700);}
function go(){if(shown)return;shown=1;pl.classList.add('is-in');setTimeout(finish,1450);}
function start(){var tall=window.matchMedia&&matchMedia('(max-aspect-ratio: 4/5)').matches,im=new Image(),sl=pl.querySelector('.pp-seal img'),a=0,b=!sl,chk=function(){if(a&&b)go();};im.onload=im.onerror=function(){a=1;chk();};im.src='assets/images/v46/gate-doors'+(tall?'-tall-md':'')+'.webp';if(im.complete)a=1;if(sl){if(sl.complete)b=1;else sl.onload=sl.onerror=function(){b=1;chk();};}chk();setTimeout(go,1400);setTimeout(finish,4600);pl.addEventListener('click',finish);pl.addEventListener('touchstart',finish,{passive:true});document.addEventListener('keydown',function k(){finish();document.removeEventListener('keydown',k);});}
if(document.prerendering){document.addEventListener('prerenderingchange',start,{once:true});}else{start();}})();</script> <div class="scroll-progress" aria-hidden="true"><i id="scrollProgress"></i></div> <div class="announce" id="announce"> <div class="announce-inner"> <p> <i class="fa-solid fa-truck-fast" aria-hidden="true"></i> <span>Complimentary express delivery on prepaid orders across Pakistan &amp; the UAE</span> </p> <button class="announce-close" type="button" data-announce-close aria-label="Dismiss announcement"> <i class="fa-solid fa-xmark" aria-hidden="true"></i> </button> </div> </div> <script>/* The bar's height is known before the first paint, so the header never jumps. */(function(b){try{if(sessionStorage.getItem('sfiva.announce.hidden')===(b.getAttribute('data-ev')||'1')){b.parentNode.removeChild(b);return;}}catch(e){}document.documentElement.style.setProperty('--announce-h',b.offsetHeight+'px');})(document.getElementById('announce'));</script> <header class="header" id="header"> <div class="wrap wrap-wide header-inner"> <a class="brand" href="/" aria-label="WAFA SMART TECH home"> <img src="assets/images/sfiva-logo.svg" alt="" width="40" height="40"> <span class="brand-word">WAFA SMART TECH<sup class="tm">™</sup><small class="brand-est">Est. 2009</small></span> </a> <nav class="nav eco-nav" aria-label="Primary"> <div class="mega-wrap"> <button type="button" class="mega-btn" data-mega aria-expanded="false" aria-controls="megaMenu">Shop <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button> <div class="mega" id="megaMenu" hidden> <div class="mega-earnbar"> <a class="meb-head" href="/earn"><i class="fa-solid fa-handshake" aria-hidden="true"></i> Earn with WAFA SMART TECH</a> <a href="/earn#b2b">Wholesale &amp; B2B</a><a href="/earn#dropship">Dropshipping</a><a href="/earn#ambassador">Creators</a><a href="/earn#investor">Investors &amp; franchise</a><a href="/careers">Careers</a><a href="/#maisons">WAFA SMART TECH Maisons <small>Soon</smal